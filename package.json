{
  "name": "solana-quant-research-lab-monorepo",
  "private": true,
  "version": "1.2.0",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "typecheck": "npm --prefix frontend run typecheck && frontend/node_modules/.bin/tsc -p edge/tsconfig.json",
    "test:edge": "node --test edge/tests.mjs",
    "test:wallet": "node scripts/test-wallet.mjs",
    "test:audit-ui": "node scripts/test-audit-ui.mjs",
