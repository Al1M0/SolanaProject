    "dev": "npm --prefix frontend run dev --"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  }
}
