# Docker Compose (local-only defaults). Use a URL-safe password for the interpolated DB URL.
POSTGRES_PASSWORD=quantlab-local-dev
HELIUS_API_KEY=
BIRDEYE_API_KEY=
# Server-only read-only mainnet endpoint. Empty uses Helius when configured, else public RPC.
SOLANA_RPC_URL=
COINGECKO_DEMO_API_KEY=

# For native development, copy this file to backend/.env.
DATABASE_URL=sqlite:///./quantlab.db
CORS_ORIGINS=http://localhost:3000,http://localhost:4173
APP_ORIGIN=http://localhost:3000
# Set true behind HTTPS in production. Local localhost development uses false.
SESSION_COOKIE_SECURE=false
SEED_DEMO=true
MAX_CONCURRENT_JOBS=2
# Optional API-only bearer authorization, intended for a reverse proxy / non-browser clients.
API_TOKEN=

# Frontend values are build-time variables; native dev reads frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_API_URL=http://localhost:8000
NEXT_PUBLIC_EXECUTION_MODE=api
NEXT_TELEMETRY_DISABLED=1

# Hosted Worker: configure server variables above as runtime secrets/settings.
# Hosted browser build uses NEXT_PUBLIC_EXECUTION_MODE=browser and an empty chain URL
# so /api calls go to the same HTTPS origin. Never put provider keys in NEXT_PUBLIC_*.
